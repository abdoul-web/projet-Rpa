# URL et clé publique du projet Supabase (Réglages > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" (Réglages > API) — SECRÈTE, jamais exposée au navigateur.
# Utilisée uniquement dans les server actions pour inviter des employés.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (utilisée dans les liens envoyés par courriel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notifications programmées (rappels du plan de travail).
# Générez votre propre paire avec : node scripts/generate-vapid-keys.mjs
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Adresse de contact exigée par le protocole Web Push (mailto: ou https:)
VAPID_SUBJECT=mailto:vous@exemple.com

# Fuseau horaire utilisé pour comparer l'heure des tâches (IANA timezone)
APP_TIMEZONE=America/Toronto

# Secret partagé pour autoriser le service de cron externe à déclencher
# l'envoi des rappels (générez une chaîne aléatoire, ex: openssl rand -hex 32)
CRON_SECRET=

# Assistant IA (page "Aide") — optionnel. Clé obtenue sur console.anthropic.com.
# Sans cette clé, la page Aide affiche un message d'erreur mais le reste de
# l'application fonctionne normalement. Utilisation payante (voir README).
ANTHROPIC_API_KEY=
