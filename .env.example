# URL et clé publique du projet Supabase (Réglages > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" (Réglages > API) — SECRÈTE, jamais exposée au navigateur.
# Utilisée uniquement dans les server actions pour inviter des employés.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (utilisée dans les liens envoyés par courriel)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
